{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false
    },
    "wtop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^WT-[A-Z0-9][A-Z0-9-]*$"
        },
        "profile": {
          "const": "wtop-spec/1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "proposed-normative",
            "accepted-normative",
            "informative"
          ]
        },
        "review": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^WT-[A-Z0-9][A-Z0-9-]*$"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^WT-REQ-[A-Z0-9][A-Z0-9-]*$"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "profile",
        "version",
        "authority",
        "review",
        "depends_on",
        "requirements"
      ],
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "resource"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "resource",
    "tags",
    "status",
    "generated",
    "wtop",
    "sources"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wtop:schema:frontmatter:1",
  "title": "Wtop bounded authoring profile over OKF0.2"
}
